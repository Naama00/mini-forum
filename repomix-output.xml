                                <div className="flex flex-wrap gap-1.5">
                                    {event.tags.map(tag => (
                                        <span key={tag} className="font-mono text-xs px-2 py-0.5 bg-white/5 border border-white/10 text-slate-400 rounded">
                                            #{tag}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        )}
                    </div>

                </div>
            </div>
        </div>
    );
}
