/* ═══════════════════════════════════════════════════════════════════════════════
   RESPONSIVE.CSS - Mobile-First Responsive Design System
   ═══════════════════════════════════════════════════════════════════════════════ */

/* ──────────────────────────────────────────────────────────────────────────────
   SMALL MOBILE (< 480px)
   ────────────────────────────────────────────────────────────────────────────── */
@media (max-width: 479px) {
  body {
    font-size: var(--font-sm);
  }

  .page-container {
    padding: var(--space-lg);
  }

  .container {
    padding: 0 var(--space-md);
    margin: 0 auto;
  }

  h1 {
    font-size: var(--font-3xl);
    margin-bottom: var(--space-md);
  }

  h2 {
    font-size: var(--font-2xl);
  }

  h3 {
    font-size: var(--font-xl);
  }

  /* Cards & Components */
  .card {
    padding: var(--space-md);
    border-radius: var(--radius-lg);
  }

  /* Buttons - Larger touch targets */
  button,
  .btn,
  .cta-btn {
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    width: 100%;
    font-size: var(--font-xs);
  }

  /* Forms */
  input,
  textarea,
  select {
    font-size: 16px; /* Prevents zoom on focus in iOS */
    min-height: 44px;
  }

  /* Layout Adjustments */
  .app-content-layout {
    flex-direction: column;
  }

  .page-header {
    padding: var(--space-lg) 0;
    margin-bottom: var(--space-lg);
  }

  /* Navigation */
  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    z-index: 999;
  }

  .sidebar.active {
    transform: translateX(0);
  }

  /* Grid -> Stack */
  .items-grid {
    grid-template-columns: 1fr;
  }

  /* Modals */
  .modal,
  .dialog {
    max-width: 95%;
    max-height: 95vh;
  }

  .modal-header,
  .dialog-header {
    padding: var(--space-lg);
  }

  .modal-body,
  .dialog-body {
    padding: var(--space-lg);
  }

  /* Pagination */
  .pagination {
    gap: var(--space-xs);
  }

  .pagination-item {
    min-width: 36px;
    height: 36px;
    font-size: var(--font-xs);
  }

  /* Tables - Horizontal scroll */
  table {
    overflow-x: auto;
    display: block;
  }

  thead {
    display: none;
  }

  tr {
    display: block;
    border-bottom: 2px solid var(--border-primary);
    margin-bottom: var(--space-lg);
  }

  td {
    display: block;
    text-align: right;
    padding-right: var(--space-lg);
    padding-left: 40%;
    position: relative;
    border: none;
  }

  td::before {
    content: attr(data-label);
    position: absolute;
    left: 0;
    width: 35%;
    text-align: left;
    font-weight: var(--font-weight-bold);
    color: var(--accent);
  }
}

/* ──────────────────────────────────────────────────────────────────────────────
   TABLET / MOBILE LANDSCAPE (480px - 768px)
   ────────────────────────────────────────────────────────────────────────────── */
@media (min-width: 480px) and (max-width: 768px) {
  body {
    font-size: var(--font-base);
  }

  .page-container {
    padding: var(--space-2xl) var(--space-lg);
  }

  .container {
    padding: 0 var(--space-lg);
    max-width: 100%;
  }

  h1 {
    font-size: clamp(var(--font-2xl), 4vw, var(--font-3xl));
  }

  /* Grid Adjustment */
  .items-grid {
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--space-lg);
  }

  /* Buttons */
  button,
  .btn,
  .cta-btn {
    min-height: 44px;
    padding: var(--space-md);
    font-size: var(--font-sm);
  }

  /* Layout */
  .app-content-layout {
    flex-direction: column;
  }

  /* Sidebar - Drawer */
  .sidebar {
    position: fixed;
    left: -260px;
    top: 0;
    width: 260px;
    height: 100vh;
    transition: left 0.3s ease;
    z-index: 999;
  }

  .sidebar.active {
    left: 0;
  }

  /* Modal */
  .modal,
  .dialog {
    max-width: 90%;
  }

  /* Pagination */
  .pagination {
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .pagination-item {
    min-width: 40px;
    height: 40px;
  }
}

/* ──────────────────────────────────────────────────────────────────────────────
   SMALL DESKTOP (768px - 1024px)
   ────────────────────────────────────────────────────────────────────────────── */
@media (min-width: 769px) and (max-width: 1024px) {
  .page-container {
    padding: var(--space-2xl);
  }

  .items-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .app-content-layout {
    max-width: 100%;
  }

  .page-header-title {
    font-size: clamp(var(--font-2xl), 5vw, var(--font-3xl));
  }
}

/* ──────────────────────────────────────────────────────────────────────────────
   LARGE DESKTOP (1025px+)
   ────────────────────────────────────────────────────────────────────────────── */
@media (min-width: 1025px) {
  .page-container {
    padding: var(--space-3xl);
  }

  .items-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2xl);
  }

  .sidebar {
    position: static;
    width: 260px;
  }

  .app-content-layout {
    max-width: 1400px;
  }
}

/* ──────────────────────────────────────────────────────────────────────────────
   HIGH DPI DISPLAYS (Retina)
   ────────────────────────────────────────────────────────────────────────────── */
@media (-webkit-min-device-pixel-ratio: 2), (min-device-pixel-ratio: 2) {
  body {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .spinner,
  .spinner-small {
    border-width: 2px;
  }
}

/* ──────────────────────────────────────────────────────────────────────────────
   LANDSCAPE MODE
   ────────────────────────────────────────────────────────────────────────────── */
@media (orientation: landscape) and (max-height: 600px) {
  .page-header {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  h1, h2, h3 {
    margin-bottom: var(--space-sm);
  }

  .page-container {
    padding: var(--space-lg);
  }
}

/* ──────────────────────────────────────────────────────────────────────────────
   PORTRAIT MODE (Force)
   ────────────────────────────────────────────────────────────────────────────── */
@media (orientation: portrait) {
  .items-grid {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
}

/* ──────────────────────────────────────────────────────────────────────────────
   ACCESSIBILITY - REDUCED MOTION
   ────────────────────────────────────────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  html {
    scroll-behavior: auto;
  }
}

/* ──────────────────────────────────────────────────────────────────────────────
   ACCESSIBILITY - HIGH CONTRAST MODE
   ────────────────────────────────────────────────────────────────────────────── */
@media (prefers-contrast: more) {
  .border-primary {
    border-width: 2px;
  }

  button,
  .btn {
    border-width: 2px;
  }

  .text-muted {
    opacity: 0.8;
  }
}

/* ──────────────────────────────────────────────────────────────────────────────
   PRINT STYLES
   ────────────────────────────────────────────────────────────────────────────── */
@media print {
  body {
    background-color: white;
    color: black;
  }

  .modal-overlay,
  .sidebar,
  .navbar,
  .breadcrumb {
    display: none;
  }

  .page-container {
    padding: 0;
    max-width: 100%;
  }

  a {
    text-decoration: underline;
  }

  h1, h2, h3, h4, h5, h6 {
    page-break-after: avoid;
  }

  p {
    orphans: 3;
    widows: 3;
  }
}

/* ──────────────────────────────────────────────────────────────────────────────
   DARK MODE SYSTEM PREFERENCE
   ────────────────────────────────────────────────────────────────────────────── */
@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: dark;
  }
}

@media (prefers-color-scheme: light) {
  :root {
    color-scheme: light;
  }
}

/* ──────────────────────────────────────────────────────────────────────────────
   LANDSCAPE SMALL SCREENS
   ────────────────────────────────────────────────────────────────────────────── */
@media (max-height: 500px) {
  .page-header {
    margin-bottom: var(--space-md);
  }

  .card {
    padding: var(--space-md);
  }

  button {
    padding: var(--space-sm);
  }
}
