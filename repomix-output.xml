  gap: 16px !important;
}

.modal-title,
.dialog-title {
  font-size: 22px !important;
  font-weight: 800 !important;
  background: linear-gradient(90deg, #00f0ff, #a855f7) !important;
  -webkit-background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  background-clip: text !important;
  margin: 0 !important;
  padding: 0 !important;
  letter-spacing: -0.5px !important;
}

.modal-close,
.dialog-close {
  background: rgba(0, 240, 255, 0.1) !important;
  border: 1px solid rgba(0, 240, 255, 0.2) !important;
  color: rgba(0, 240, 255, 0.7) !important;
  width: 40px !important;
  height: 40px !important;
  border-radius: 10px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  cursor: pointer !important;
  transition: all 0.2s ease !important;
  padding: 0 !important;
  font-size: 20px !important;
  font-weight: 700 !important;
  flex-shrink: 0 !important;
}

.modal-close:hover,
.dialog-close:hover {
  background: rgba(255, 0, 110, 0.15) !important;
  border-color: #ff006e !important;
  color: #ff006e !important;
  transform: rotate(90deg) scale(1.15) !important;
}

.modal-body,
.dialog-body {
  padding: 28px 32px !important;
  margin: 0 !important;
  color: rgba(226, 232, 240, 0.85) !important;
  font-size: 14px !important;
  line-height: 1.7 !important;
}

.modal-footer,
.dialog-footer {
  padding: 24px 32px !important;
  border-top: 1px solid rgba(0, 240, 255, 0.1) !important;
  margin: 0 !important;
  display: flex !important;
  justify-content: flex-end !important;
  align-items: center !important;
  gap: 12px !important;
  flex-wrap: wrap !important;
}

.modal-btn,
.dialog-btn {
  padding: 11px 24px !important;
  border: none !important;
  border-radius: 10px !important;
  font-size: 13px !important;
  font-weight: 800 !important;
  cursor: pointer !important;
  transition: all 0.3s ease !important;
  letter-spacing: 0.5px !important;
}

.modal-btn.primary,
.dialog-btn.primary {
  background: linear-gradient(135deg, #00f0ff, #00d9ff) !important;
  color: #0a0e1a !important;
  box-shadow: 0 0 20px rgba(0, 240, 255, 0.3) !important;
}

.modal-btn.primary:hover,
.dialog-btn.primary:hover {
  transform: translateY(-3px) !important;
  box-shadow: 0 0 30px rgba(0, 240, 255, 0.5) !important;
}

.modal-btn.secondary,
.dialog-btn.secondary {
  background: rgba(0, 240, 255, 0.1) !important;
  color: #00f0ff !important;
  border: 1.5px solid rgba(0, 240, 255, 0.3) !important;
}

.modal-btn.secondary:hover,
.dialog-btn.secondary:hover {
  background: rgba(0, 240, 255, 0.2) !important;
  border-color: #00f0ff !important;
  transform: translateY(-2px) !important;
}

/* ─────────────────────────────────────────────────────────────────────---- */
/* ALERTS & NOTIFICATIONS - אזהרות הודעות צבעוניות */
/* ──────────────────────────────────────────────────────────────────────── */

.alert,
.notification {
  padding: 16px 20px !important;
  border-radius: 12px !important;
  margin-bottom: 16px !important;
  display: flex !important;
  align-items: flex-start !important;
  gap: 14px !important;
  border-left: 4px solid !important;
  animation: slideInDown 0.4s ease both !important;
}

.alert-icon,
.notification-icon {
  flex-shrink: 0 !important;
  font-size: 20px !important;
  font-weight: 800 !important;
  margin-top: 2px !important;
}

.alert-content,
.notification-content {
  flex: 1 !important;
}

.alert-title,
.notification-title {
  font-weight: 800 !important;
  margin: 0 0 4px 0 !important;
  font-size: 13px !important;
}

.alert-message,
.notification-message {
  font-size: 12px !important;
  margin: 0 !important;
  opacity: 0.9 !important;
  line-height: 1.4 !important;
}

.alert-close,
.notification-close {
  background: none !important;
  border: none !important;
  color: inherit !important;
  cursor: pointer !important;
  font-size: 18px !important;
  padding: 0 !important;
  flex-shrink: 0 !important;
  opacity: 0.6 !important;
  transition: all 0.2s ease !important;
}

.alert-close:hover,
.notification-close:hover {
  opacity: 1 !important;
  transform: rotate(90deg) !important;
}

/* Success Alert */
.alert-success,
.notification-success {
  background: linear-gradient(135deg, rgba(0, 255, 136, 0.08), rgba(0, 255, 136, 0.02)) !important;
  border-left-color: #00ff88 !important;
  color: #00ff88 !important;
  box-shadow: 
    0 0 20px rgba(0, 255, 136, 0.15),
    inset 0 0 15px rgba(0, 255, 136, 0.03) !important;
}

/* Error Alert */
.alert-error,
.notification-error {
  background: linear-gradient(135deg, rgba(255, 0, 110, 0.08), rgba(255, 0, 110, 0.02)) !important;
  border-left-color: #ff006e !important;
  color: #ff006e !important;
  box-shadow: 
    0 0 20px rgba(255, 0, 110, 0.15),
    inset 0 0 15px rgba(255, 0, 110, 0.03) !important;
}

/* Warning Alert */
.alert-warning,
.notification-warning {
  background: linear-gradient(135deg, rgba(255, 107, 0, 0.08), rgba(255, 107, 0, 0.02)) !important;
  border-left-color: #ff6b00 !important;
  color: #ff6b00 !important;
  box-shadow: 
    0 0 20px rgba(255, 107, 0, 0.15),
    inset 0 0 15px rgba(255, 107, 0, 0.03) !important;
}

/* Info Alert */
.alert-info,
.notification-info {
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.08), rgba(0, 240, 255, 0.02)) !important;
  border-left-color: #00f0ff !important;
  color: #00f0ff !important;
  box-shadow: 
    0 0 20px rgba(0, 240, 255, 0.15),
    inset 0 0 15px rgba(0, 240, 255, 0.03) !important;
}

/* ─────────────────────────────────────────────────────────────────────---- */
/* BADGES & TAGS - תגיות וביקוע */
/* ──────────────────────────────────────────────────────────────────────── */

.badge {
  display: inline-flex !important;
  align-items: center !important;
  padding: 6px 14px !important;
  border-radius: 8px !important;
  font-size: 11px !important;
  font-weight: 800 !important;
  letter-spacing: 0.5px !important;
  text-transform: uppercase !important;
  margin: 0 !important;
  transition: all 0.2s ease !important;
  white-space: nowrap !important;
  box-shadow: 0 0 12px rgba(0, 240, 255, 0.1) !important;
}

.badge:hover {
  transform: scale(1.08) !important;
  box-shadow: 0 0 18px rgba(0, 240, 255, 0.2) !important;
}

.badge-primary {
  background: linear-gradient(135deg, #00f0ff, #00d9ff) !important;
  color: #0a0e1a !important;
}

.badge-secondary {
  background: linear-gradient(135deg, #a855f7, #9333ea) !important;
  color: #f3e8ff !important;
}

.badge-success {
  background: linear-gradient(135deg, #00ff88, #00cc6a) !important;
  color: #0a1a10 !important;
}

.badge-danger {
  background: linear-gradient(135deg, #ff006e, #e60052) !important;
  color: #fff5fa !important;
}

.badge-warning {
  background: linear-gradient(135deg, #ff6b00, #cc5500) !important;
  color: #fff7ed !important;
}

.badge-outline {
  background: transparent !important;
  border: 1.5px solid currentColor !important;
}

.tag {
  display: inline-flex !important;
  align-items: center !important;
  gap: 10px !important;
  padding: 8px 16px !important;
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.1), rgba(168, 85, 247, 0.06)) !important;
  border: 1.5px solid rgba(0, 240, 255, 0.25) !important;
  border-radius: 10px !important;
  font-size: 12px !important;
  color: rgba(0, 240, 255, 0.85) !important;
  transition: all 0.25s ease !important;
  box-shadow: 0 0 10px rgba(0, 240, 255, 0.05) !important;
}

.tag:hover {
  background: rgba(0, 240, 255, 0.15) !important;
  border-color: #00f0ff !important;
  color: #00f0ff !important;
  box-shadow: 0 0 15px rgba(0, 240, 255, 0.2) !important;
  transform: translateY(-2px) !important;
}

.tag-close {
  width: 16px !important;
  height: 16px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  cursor: pointer !important;
  opacity: 0.6 !important;
  transition: all 0.2s ease !important;
  font-weight: 800 !important;
}

.tag-close:hover {
  opacity: 1 !important;
  transform: rotate(90deg) scale(1.2) !important;
}

/* ─────────────────────────────────────────────────────────────────────---- */
/* PAGINATION - עמודים */
/* ──────────────────────────────────────────────────────────────────────── */

.pagination {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px !important;
  margin: 32px 0 !important;
  padding: 0 !important;
  list-style: none !important;
}

.pagination-item {
  margin: 0 !important;
  padding: 0 !important;
}

.pagination-link {
  min-width: 40px !important;
  height: 40px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 8px !important;
  border: 1.5px solid rgba(0, 240, 255, 0.2) !important;
  background: linear-gradient(135deg, rgba(0, 240, 255, 0.06), rgba(0, 240, 255, 0.02)) !important;
  color: rgba(0, 240, 255, 0.65) !important;
  border-radius: 10px !important;
  text-decoration: none !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  cursor: pointer !important;
  transition: all 0.25s ease !important;
  box-shadow: inset 0 0 8px rgba(0, 240, 255, 0.02) !important;
}

.pagination-link:hover:not(.disabled) {
  background: rgba(0, 240, 255, 0.15) !important;
  border-color: #00f0ff !important;
  color: #00f0ff !important;
  box-shadow: 0 0 15px rgba(0, 240, 255, 0.2) !important;
  transform: translateY(-2px) !important;
}

.pagination-link.active {
  background: linear-gradient(135deg, #00f0ff, #00d9ff) !important;
  border-color: #00f0ff !important;
  color: #0a0e1a !important;
  font-weight: 800 !important;
  box-shadow: 0 0 20px rgba(0, 240, 255, 0.3) !important;
}

.pagination-link.disabled {
  opacity: 0.3 !important;
  cursor: not-allowed !important;
}

.pagination-info {
  font-size: 12px !important;
  color: rgba(148, 163, 184, 0.6) !important;
  margin: 0 12px !important;
  padding: 0 !important;
}

/* ─────────────────────────────────────────────────────────────────────---- */
/* LOADING STATES - טוען */
/* ──────────────────────────────────────────────────────────────────────── */

.loader {
  display: inline-block !important;
  width: 24px !important;
  height: 24px !important;
  border: 3px solid rgba(0, 240, 255, 0.1) !important;
  border-top-color: #00f0ff !important;
  border-radius: 50% !important;
  animation: spin 0.8s linear infinite !important;
  box-shadow: 0 0 12px rgba(0, 240, 255, 0.2) !important;
}

.loader-lg {
  width: 48px !important;
  height: 48px !important;
  border-width: 4px !important;
  box-shadow: 0 0 20px rgba(0, 240, 255, 0.3) !important;
}

.skeleton {
  background: linear-gradient(
    90deg,
    rgba(0, 240, 255, 0.05),
    rgba(0, 240, 255, 0.15),
    rgba(0, 240, 255, 0.05)
  ) !important;
  background-size: 200% 100% !important;
  animation: shimmer 2s infinite !important;
  border-radius: 6px !important;
}

.skeleton-text {
  height: 12px !important;
  margin-bottom: 10px !important;
  border-radius: 4px !important;
}

.skeleton-heading {
  height: 28px !important;
  margin-bottom: 16px !important;
  width: 60% !important;
  border-radius: 6px !important;
}

/* ─────────────────────────────────────────────────────────────────────---- */
/* TOOLTIPS - כיוונים */
/* ──────────────────────────────────────────────────────────────────────── */

.tooltip-wrapper {
  position: relative !important;
  display: inline-block !important;
}

.tooltip {
  position: absolute !important;
  bottom: 130% !important;
  left: 50% !important;
  transform: translateX(-50%) !important;
  background: linear-gradient(135deg, rgba(10, 14, 26, 0.95), rgba(15, 27, 46, 0.9)) !important;
  border: 1.5px solid rgba(0, 240, 255, 0.3) !important;
  color: rgba(0, 240, 255, 0.85) !important;
  padding: 10px 14px !important;
  border-radius: 8px !important;
  font-size: 11px !important;
  white-space: nowrap !important;
  z-index: 1000 !important;
  opacity: 0 !important;
  pointer-events: none !important;
  transition: all 0.25s ease !important;
  box-shadow: 0 0 20px rgba(0, 240, 255, 0.15) !important;
}

.tooltip::after {
  content: '' !important;
  position: absolute !important;
  top: 100% !important;
  left: 50% !important;
  transform: translateX(-50%) !important;
  border: 6px solid transparent !important;
  border-top-color: rgba(0, 240, 255, 0.3) !important;
}

.tooltip-wrapper:hover .tooltip {
  opacity: 1 !important;
  transform: translateX(-50%) translateY(0) !important;
}

/* ─────────────────────────────────────────────────────────────────────---- */
/* PROGRESS BAR - בר התקדמות */
/* ──────────────────────────────────────────────────────────────────────── */

.progress {
  height: 8px !important;
  background: rgba(0, 240, 255, 0.08) !important;
  border-radius: 4px !important;
  overflow: hidden !important;
  margin: 16px 0 !important;
  box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.3) !important;
}

.progress-bar {
  height: 100% !important;
  background: linear-gradient(90deg, #00f0ff, #00ff88) !important;
  border-radius: 4px !important;
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
  box-shadow: 
    0 0 15px rgba(0, 240, 255, 0.3),
    inset 0 0 6px rgba(255, 255, 255, 0.15) !important;
}

.progress-bar.animated {
  animation: progressPulse 2s ease-in-out infinite !important;
}

@keyframes progressPulse {
  0%, 100% {
    box-shadow: 
      0 0 15px rgba(0, 240, 255, 0.3),
      inset 0 0 6px rgba(255, 255, 255, 0.15);
  }
  50% {
    box-shadow: 
      0 0 25px rgba(0, 240, 255, 0.5),
      inset 0 0 10px rgba(255, 255, 255, 0.2);
  }
}

/* ─────────────────────────────────────────────────────────────────────---- */
/* ANIMATIONS - אנימציות */
/* ──────────────────────────────────────────────────────────────────────── */

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

@keyframes slideInDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8px);
  }
}

/* ─────────────────────────────────────────────────────────────────────---- */
/* RESPONSIVE ADJUSTMENTS - מותאם לנייד */
/* ──────────────────────────────────────────────────────────────────────── */

@media (max-width: 768px) {
  .modal,
  .dialog {
    max-width: calc(100% - 40px) !important;
  }

  .modal-header,
  .dialog-header {
    padding: 24px !important;
  }

  .modal-body,
  .dialog-body {
    padding: 20px 24px !important;
  }

  .modal-footer,
  .dialog-footer {
    padding: 20px 24px !important;
    flex-direction: column-reverse !important;
  }

  .modal-btn,
  .dialog-btn {
    width: 100% !important;
  }

  .alert,
  .notification {
    padding: 14px 16px !important;
    font-size: 12px !important;
  }

  .pagination-link {
    width: 36px !important;
    height: 36px !important;
  }
}

@media (max-width: 480px) {
  .modal-title,
  .dialog-title {
    font-size: 18px !important;
  }

  .pagination {
    gap: 4px !important;
  }

  .pagination-link {
    width: 32px !important;
    height: 32px !important;
    font-size: 11px !important;
  }
}
