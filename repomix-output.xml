/* ─── אנימציות כניסה חדשות ─── */

.topic-row {
    opacity: 0;
    animation: slideInRight 0.5s ease forwards;
}

/* יצירת אפקט מדורג (Staggered animation) */
.topic-row:nth-child(1) { animation-delay: 0.1s; }
.topic-row:nth-child(2) { animation-delay: 0.2s; }
.topic-row:nth-child(3) { animation-delay: 0.3s; }

